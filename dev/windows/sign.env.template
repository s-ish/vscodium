# Copy to dev/windows/sign.env for local Authenticode signing (gitignored).
# Used when packaging with ./dev/build-grok-ade.sh -p

# Base64-encoded .pfx export of your code-signing certificate
WINDOWS_CERTIFICATE_PFX_DATA=
WINDOWS_CERTIFICATE_PFX_PASSWORD=
# Optional timestamp server (default: http://timestamp.digicert.com)
WINDOWS_TIMESTAMP_URL=